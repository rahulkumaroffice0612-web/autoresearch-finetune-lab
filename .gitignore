# Secrets — never commit
.env
*.key
*.pem

# The sealed test set: the raw cases must NEVER enter git or be readable by the
# overnight worker. Only the hash manifest (data/sealed/test.sha256) is tracked.
data/sealed/test.jsonl
data/sealed/*.raw

# Training data pulled from the Hub (regenerated by src/prepare_data.py)
data/train.jsonl

# Model artifacts
artifacts/adapters/
artifacts/merged/
*.safetensors
*.gguf

# Scratch run logs (stdout captures) — not part of the repo
artifacts/*.out
artifacts/*.log

# Raw source image for the HF hero (published to HF as lazydecider.png)
data/*_Generated_Image_*.png

# Large prediction dumps (regenerable by the scorer)
artifacts/test_predictions.jsonl
artifacts/tinker_test_predictions.jsonl

# best_model/ is published to Hugging Face; keep only the human-readable card +
# the leaderboard YAML in git, not the multi-GB weights/tokenizer blobs.
artifacts/best_model/*
!artifacts/best_model/README.md
!artifacts/best_model/train_config.json
!artifacts/best_model/select_metrics.json
!artifacts/best_model/unsloth_decision_config.json
!artifacts/best_model/.eval_results/
!artifacts/best_model/.eval_results/**

# Generated demo narration audio: keep the committed MP3s (free macOS `say`
# output), but ignore any stray scratch/probe files.
artifacts/demo_audio/_*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node (voiceover generator deps; package.json + lockfile stay tracked)
node_modules/

# OS
.DS_Store
